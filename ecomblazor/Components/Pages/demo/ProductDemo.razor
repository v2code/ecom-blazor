<br />

@code {

    List<Product> ProductList = new();

    protected override async Task OnInitializedAsync()
    {
        await Task.Delay(1000);
        var product1 = new Product
            {
                Id = 2,
                Name = "Product 2",
                Price = 200,
                IsActive = true,
                Properties = new List<ProductProp>()
                {
                    { new ProductProp { id=1, Key = "Navya", Value = "Blue" } },
                    { new ProductProp { id=2, Key = "Size", Value = "L" }  },
                    { new ProductProp { id=3, Key = "Weight", Value = "2kg" }  }
                }
            };

        var product2 = new Product
            {
                Id = 3,
                Name = "Product 3",
                Price = 300,
                IsActive = true,
                Properties = new List<ProductProp>()
                {
                    { new ProductProp { id=1, Key = "Color", Value = "Blue" } },
                    { new ProductProp { id=2, Key = "Size", Value = "L" }  },
                    { new ProductProp { id=3, Key = "Weight", Value = "2kg" }  }
                }
            };

        ProductList.Add(product1);
        ProductList.Add(product2);
    }
}
